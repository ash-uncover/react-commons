{
  "name": "@sol.ac/react-commons",
  "version": "1.0.0",
  "author": "aSH <ash.uncover@gmail.com>",
  "description": "React common components",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ash-uncover/react-commons"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "npm run build:clean && npm run build:tsc && npm run build:babel && npm run build:clean-tests",
    "build:clean": "rm -rf dist",
    "build:clean-tests": "find dist -name '*.spec.js' -o -name '*.test.js' -o -name '*.spec.d.ts' -o -name '*.test.d.ts' | xargs rm -f",
    "build:babel": "babel src/lib --extensions .ts,.tsx --out-dir dist --copy-files --no-copy-ignored --ignore \"**/*.spec.ts,**/*.spec.tsx,**/*.test.ts,**/*.test.tsx\"",
    "build:docs": "webpack --config webpack.config.docs.js --mode production",
    "build:tsc": "tsc --project tsconfig.build.json",
    "watch": "npm run watch:tsc && npm run watch:babel",
    "watch:babel": "babel -w src/lib --extensions .ts,.tsx --out-dir dist --copy-files --no-copy-ignored --ignore \"**/*.spec.ts,**/*.spec.tsx,**/*.test.ts,**/*.test.tsx\"",
    "watch:tsc": "tsc -w --project tsconfig.build.json",
    "dev": "webpack serve --config webpack.config.dev.js --progress",
    "test": "jest",
    "test:coverage": "jest --collectCoverage",
    "prepare": "husky"
  },
  "peerDependencies": {
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/free-brands-svg-icons": "7.3.1",
    "@fortawesome/free-regular-svg-icons": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@fortawesome/react-fontawesome": "3.5.0",
    "@sol.ac/js-utils": "1.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-responsive": "10.0.1",
    "react-router": "8.3.1"
  },
  "devDependencies": {
    "@babel/cli": "7.29.7",
    "@babel/core": "7.29.7",
    "@babel/eslint-parser": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/jest": "30.0.0",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "babel-loader": "10.1.1",
    "copy-webpack-plugin": "14.0.0",
    "css-loader": "7.1.5",
    "html-webpack-plugin": "5.6.8",
    "husky": "9.1.7",
    "jest": "30.5.0",
    "jest-environment-jsdom": "30.5.0",
    "source-map-loader": "5.0.0",
    "style-loader": "4.0.0",
    "ts-jest": "29.4.12",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "webpack": "5.110.2",
    "webpack-cli": "7.2.3",
    "webpack-dev-server": "6.0.0"
  },
  "eslintConfig": {
    "extends": "react-app",
    "env": {
      "node": true,
      "jest": true
    }
  }
}
